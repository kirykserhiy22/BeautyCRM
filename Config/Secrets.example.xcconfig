// Шаблон секретів Beauty Base.
//
// Як користуватися (коли підключатимемо Supabase):
//   1. Скопіювати цей файл поруч як Secrets.xcconfig
//   2. Вписати справжні значення в копію
//   3. Secrets.xcconfig ніколи не потрапить у git — він у .gitignore
//
// Тут — лише назви, без справжніх значень.
// У xcconfig «//» починає коментар, тому адреса пишеться з $() посередині: https:/$()/…

SUPABASE_URL = https:/$()/your-project.supabase.co
SUPABASE_ANON_KEY = your-anon-key
